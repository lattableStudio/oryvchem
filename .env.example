# Public site URL (used for canonical, hreflang, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.oryvchem.com
NEXT_PUBLIC_CONTACT_EMAIL=inquiries@oryvchem.com

# Where inquiry forms are delivered
CONTACT_TO_EMAIL=Chorfihouda55@gmail.com

# SMTP account used to send them (any provider: Zoho, Google Workspace, Resend SMTP, Brevo, SendGrid...)
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# Optional; defaults to SMTP_USER. Must be an address your SMTP account may send as.
MAIL_FROM="Oryvchem Website <no-reply@oryvchem.com>"

# --- CRM + editable content (admin at /admin) ---
# Postgres connection string (Railway: use the PUBLIC url, add ?sslmode=require; any Postgres works). Tables are created automatically.
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Password for /admin. Use a long random one.
ADMIN_PASSWORD=
# Optional: random string used to sign the admin session cookie (defaults to a value derived from the password)
ADMIN_SECRET=
